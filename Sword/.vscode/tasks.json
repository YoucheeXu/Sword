{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "cmake",
			"command": "cmake",
			"args": [
				"-G",
				"Unix Makefiles",
				"-DCMAKE_BUILD_TYPE=Debug",
				"${fileDirname}"
			],
			"options": {
			  "cwd": "${workspaceRoot}/build"
			},
			"dependsOn":[
				"delBuildFiles"
			],
			"detail": "cmake something"
		},
		{
			"type": "shell",
			"label": "make", 
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"dependsOn":[
				"cmake"
			],
			"command": "mingw32-make",
			"args": [
				"all"
			],
			"options": {
			  "cwd": "${workspaceRoot}/build"
			},
			"detail": "make something"
		},
		{
			"type": "shell",
			"label": "delBuildFiles",
			"command": "Remove-item",
			"args": [
				"${workspaceRoot}/build/*",
				"-recurse"
			],
			// 设置为none的task不会在build task的下拉列表中展示
			"group": "none",
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent",
				"panel": "new"
			},
			"detail": "delete previous make file"
		}
	]
}